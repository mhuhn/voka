{
  "name": "voka",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run build && npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber-js --import 'tests/support/*.ts' --import 'tests/steps/*.ts' 'tests/features/*.feature'",
    "native:add:ios": "npx cap add ios",
    "native:add:android": "npx cap add android",
    "native:sync": "npm run build && npx cap sync",
    "native:open:ios": "npx cap open ios",
    "native:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.6.0",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@supabase/supabase-js": "2.57.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@cucumber/cucumber": "13.3.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "7.1.9",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.4"
  }
}
